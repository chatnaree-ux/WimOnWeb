@echo off
title WIM - ตัวเปิดใช้งานระบบ
cd /d "%~dp0"

echo ============================================
echo   กำลังเริ่มเซิร์ฟเวอร์ WIM...
echo ============================================
echo.

REM เปิด server ในหน้าต่างใหม่แยกต่างหาก (ห้ามปิดหน้าต่างนั้นระหว่างใช้งาน)
start "WIM Server - อย่าปิดหน้าต่างนี้" cmd /k npm start

REM รอสักครู่ให้ server เริ่มทำงานก่อน แล้วค่อยเปิดเบราว์เซอร์
timeout /t 3 /nobreak >nul
start http://localhost:3001

echo เปิดเบราว์เซอร์ให้แล้ว หากหน้าเว็บยังไม่ขึ้น ให้รอสักครู่แล้ว refresh
echo (หน้าต่างนี้ปิดได้เลย แต่ห้ามปิดหน้าต่าง "WIM Server")
echo.
pause